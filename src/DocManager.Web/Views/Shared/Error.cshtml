@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="h3">Sorry, something went wrong.</h1>
    <p class="text-muted">The error has been logged. Please try again in a moment.</p>
    @if (!string.IsNullOrEmpty(Model?.RequestId))
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Documents" asp-action="Index">Back to documents</a>
</div>
