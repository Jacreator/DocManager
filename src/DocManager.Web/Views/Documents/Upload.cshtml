@using DocManager.Application.Options
@using Microsoft.Extensions.Options
@model UploadDocumentViewModel
@inject IOptions<DocumentOptions> DocumentOptions
@{
    ViewData["Title"] = "Upload document";
    var allowedExtensions = string.Join(",", DocumentOptions.Value.AllowedExtensions);
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Upload document</h1>

        <partial name="_ValidationSummary" />

        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="card card-body">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" maxlength="@UploadDocumentRequestValidator.TitleMaxLength" required autofocus />
            </div>
            <div class="mb-3">
                <label asp-for="File" class="form-label"></label>
                <input asp-for="File" type="file" class="form-control" accept="@allowedExtensions" required />
                <div class="form-text">
                    Allowed types: @string.Join(", ", DocumentOptions.Value.AllowedExtensions).
                    Maximum size: @FileSizeFormatter.Format(DocumentOptions.Value.MaxFileSizeBytes).
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Upload</button>
                <a class="btn btn-link" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
