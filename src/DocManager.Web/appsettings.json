{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Documents": {
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".docx", ".png", ".jpg" ],
    "PageSize": 10
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Company": {
    "DefaultCompanyId": 1
  }
}
